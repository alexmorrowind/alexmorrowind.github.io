# Copy these values into cPanel -> Setup Python App -> Environment Variables.
# Do not commit real secrets.

DJANGO_SECRET_KEY=change-me-for-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.b1pay.uz,b1pay.uz,www.b1pay.uz,uz01.ahost.uz
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://b1pay.uz,https://www.b1pay.uz,http://b1pay.uz,http://www.b1pay.uz
CSRF_TRUSTED_ORIGINS=https://b1pay.uz,https://www.b1pay.uz,https://api.b1pay.uz

# cPanel PostgreSQL format:
# postgres://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME
DATABASE_URL=postgres://bpayuz_dbuser:db-password@localhost:5432/bpayuz_dbname

DJANGO_SUPERUSER_USERNAME=Admin1
DJANGO_SUPERUSER_EMAIL=admin1@b1.local
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password

PAYME_MERCHANT_ID=your_payme_merchant_or_cashbox_id
PAYME_MERCHANT_KEY=paste_production_key_here
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_CALLBACK_URL=https://b1pay.uz/index.html
PAYME_ACCOUNT_KEY=Bpay

PAYME_SUBSCRIBE_BASE_URL=https://checkout.paycom.uz/api
PAYME_SUBSCRIBE_ID=your_payme_subscribe_id
PAYME_SUBSCRIBE_KEY=your_payme_subscribe_key_or_password

MYID_BASE_URL=
MYID_CLIENT_ID=
MYID_USERNAME=
MYID_PASSWORD=
MYID_HOSTED_URL=

SMS_DEMO_MODE=true
SMS_DEMO_CODE=666666
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

# RSS/Atom feeds for the public news block. Review the source policy before publishing.
# Format: Source name|https://example.com/feed.xml,Another source|https://example.com/rss
NEWS_FEEDS=CBU|https://cbu.uz/ru/press_center/news/rss/,Spot|https://www.spot.uz/ru/rss/
NEWS_SYNC_USER_AGENT=B1-NewsBot/1.0
