# Copy this file to `.env` in the same folder as `manage.py`.
# Never commit `.env` to GitHub.

# Django
DJANGO_SECRET_KEY=change-me-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
DATABASE_URL=

# Public URLs
# For local test:
FRONTEND_PUBLIC_URL=http://127.0.0.1:8765/index.html
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
# For Render/GitHub Pages later:
# FRONTEND_PUBLIC_URL=https://alexmorrowind.github.io/fintech_new/front/index.html
# BACKEND_PUBLIC_URL=https://your-render-service.onrender.com

# Payme Merchant API: checkout, orders, investments, reports.
# In Payme cabinet:
# - "Ключ" is production key.
# - "Тестовый ключ" is test key.
# For testing, paste TEST key into PAYME_MERCHANT_KEY.
PAYME_MERCHANT_ID=your_payme_merchant_or_cashbox_id
PAYME_MERCHANT_KEY=paste_test_key_here
PAYME_CHECKOUT_URL=https://test.paycom.uz
PAYME_CALLBACK_URL=http://127.0.0.1:8765/index.html
PAYME_ACCOUNT_KEY=Bpay

# Payme Subscribe API: add card, SMS verify, tokenized card payments.
# These are separate credentials from Merchant API in many Payme accounts.
PAYME_SUBSCRIBE_BASE_URL=https://checkout.test.paycom.uz/api
PAYME_SUBSCRIBE_ID=your_payme_subscribe_id
PAYME_SUBSCRIBE_KEY=your_payme_subscribe_key_or_password

# Octo Money Transfer / P2P
# Public Octo merchant docs do not expose P2P by default; enable only after Octo gives endpoint/access.
OCTO_API_BASE_URL=https://secure.octo.uz
OCTO_SECRET_KEY=
OCTO_SHOP_ID=
OCTO_P2P_ENDPOINT=
OCTO_P2P_ENABLED=false

# MyID
# Leave empty for demo mode. Fill after MyID gives your credentials.
# For SDK integration (mobile app):
#   Production (real MyID server):
#     MYID_BASE_URL=https://api.myid.uz
#   Test/sandbox (MyID test server):
#     MYID_BASE_URL=https://api.devmyid.uz
#   Both need the same credential fields below.
#   The BASE_URL is used by backend; Flutter SDK will receive 'demo' or 'production'
#   environment automatically based on which server you configure.
MYID_BASE_URL=https://api.devmyid.uz
MYID_CLIENT_ID=your_myid_client_id
# OAuth secret for hosted web redirect. Server-side only; never put in Flutter or JS.
MYID_CLIENT_SECRET=your_myid_client_secret
MYID_CLIENT_HASH=your_myid_client_hash
MYID_CLIENT_HASH_ID=your_myid_client_hash_id
MYID_TEST_MODE=true
MYID_TEST_PINFL=
MYID_USERNAME=
MYID_PASSWORD=
MYID_HOSTED_URL=https://signin.myid.uz/login/
# Optional explicit values when MyID registers a non-default callback/authorization URL.
MYID_AUTHORIZATION_URL=https://signin.myid.uz/login/
MYID_REDIRECT_URI=

# Registration SMS
# Leave demo mode enabled until a real SMS provider is connected.
SMS_DEMO_MODE=true
SMS_DEMO_CODE=666666
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
